<odoo>
    <record id="freelance_project_action" model="ir.actions.act_window">
        <field name="name">Freelance Projects</field>
        <field name="res_model">freelance.project</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="freelance_project_view_list" model="ir.ui.view">
        <field name="name">freelance.project.list</field>
        <field name="model">freelance.project</field>
        <field name="arch" type="xml">
            <list>
                <fileds name="name"/>
            </list>
        </field>
    </record>

    <record id="freelance_project_view_form" model="ir.ui.view">
        <field name="name">freelance.project.form</field>
        <field name="model">freelance.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <fileds name="name"/>
                    </h1>
                    <group>
                    <fileds name="description"/>
                    <fileds name="price"/>
                    </group>

                    <group>
                        <fileds name="client_id"/>
                        <fileds name="freelancer_id"/>
                    </group>


                </sheet>
            </form>
        </field>
    </record>


    <!--    <record id="freelance_project_view_kanban" model="ir.ui.view">
            <field name="name">freelance.project.kanban</field>
            <field name="model">freelance.project</field>
            <field name="arch" type="xml">
                <kanban>

                </kanban>
            </field>
        </record>-->

</odoo>