<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root application menu -->
    <menuitem
        id="freelance_market_menu_root"
        name="Freelance Marketplace"
        sequence="10"
    />

    <!-- Freelance Projects -->
    <menuitem
        id="freelance_market_first_level_menu"
        name="Freelance Projects"
        parent="freelance_market_menu_root"
        action="freelance_project_action"
        sequence="10"
    />

    <!-- Configuration -->
    <menuitem
        id="freelance_market_second_level_menu"
        name="Configuration"
        parent="freelance_market_menu_root"
        sequence="20"
    />

    <!-- Project Categories -->
    <menuitem
        id="freelance_market_category_submenu"
        name="Project Categories"
        parent="freelance_market_second_level_menu"
        action="project_category_action"
        sequence="10"
    />

</odoo>
